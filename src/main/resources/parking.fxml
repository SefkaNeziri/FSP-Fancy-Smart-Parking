
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dk.via.pro3.ParkingController"
      stylesheets="@styles.css"
      styleClass="page"
      alignment="CENTER"
      spacing="12"
      prefWidth="760"
      prefHeight="580">

    <children>
        <Label text="Find Parking"
               styleClass="section-title"/>

        <Label text="Choose a parking spot and reservation time"
               styleClass="subtitle"/>

        <ListView fx:id="parkingList"
                  maxWidth="550"
                  prefHeight="130"/>

        <Label text="Parking Spot"/>

        <ComboBox fx:id="spotComboBox"
                  prefWidth="350"/>

        <HBox alignment="CENTER" spacing="12">
            <children>
                <VBox spacing="5">
                    <children>
                        <Label text="Date"/>
                        <DatePicker fx:id="datePicker"
                                    prefWidth="160"/>
                    </children>
                </VBox>

                <VBox spacing="5">
                    <children>
                        <Label text="Start Time"/>
                        <ComboBox fx:id="timeComboBox"
                                  prefWidth="110"/>
                    </children>
                </VBox>

                <VBox spacing="5">
                    <children>
                        <Label text="Hours"/>
                        <ComboBox fx:id="hoursComboBox"
                                  prefWidth="90"/>
                    </children>
                </VBox>
            </children>
        </HBox>

        <Label fx:id="priceLabel"
               text="Estimated price: €0.00"
               styleClass="price-label"/>

        <Button text="Reserve Parking"
                onAction="#handleReserve"
                styleClass="primary-button"
                prefWidth="220"/>

        <Button text="Back to Dashboard"
                onAction="#handleBack"
                styleClass="secondary-button"/>

        <Label text="Demo parking data - not live availability"
               styleClass="demo-label"/>
    </children>
</VBox>
